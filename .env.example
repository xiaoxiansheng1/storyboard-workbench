# ---------- 服务 ----------
PORT=8787
# 数据目录，默认 ./data（project.json + assets/ + exports/）
# DATA_DIR=data

# 合成视频用的 ffmpeg，默认从 PATH 查找
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# ---------- 生图供应商 ----------
# aiclone = AIClone 生图 API（默认，需要在页面「系统设置」填 Key）
# mock = 本地 SVG 占位图，仅用于测试，不会调用真实接口
# openai = 任意兼容 OpenAI /images/generations 的端点
IMAGE_PROVIDER=aiclone

# AIClone：页面「系统设置」也可以填 Key、切换默认模型
AICLONE_BASE_URL=https://api.aiclonevoicefree.com
AICLONE_API_KEY=
AICLONE_IMAGE_MODEL=gpt-image-2
# 任务轮询间隔（毫秒）
AICLONE_POLL_MS=2000

# 兼容端点：OpenAI / 硅基流动 / 火山 / 自建 one-api / ComfyUI 网关等
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# 首帧统一 16:9。注意不同模型支持的尺寸不同：
#   gpt-image-1 只接受 1024x1024 / 1536x1024 / 1024x1536
#   dall-e-3   接受 1024x1024 / 1792x1024 / 1024x1536
#   多数兼容端点 / SD 系接受 1280x720
IMAGE_SIZE=1280x720
# 可选：low / medium / high，留空则不发送
IMAGE_QUALITY=
# auto = 不发送 response_format，同时兼容 b64_json 与 url 返回
# b64_json / url = 强制发送对应值
IMAGE_RESPONSE_FORMAT=auto

# 是否把英文负面词以 "Avoid: ..." 追加到 prompt 末尾（生图 API 无原生负面词参数）
APPEND_NEGATIVE=true
# 用英文还是中文提示词送模型：zh / en（默认 zh，和检查器里看到的中文提示词一致）
PROMPT_LANG=zh
# 是否把 seed 传给端点（部分端点不认这个字段会报 400）
REQUEST_SEED=false

# 并发与预算护栏（也可在页面「系统设置」里修改，页面设置优先）
IMAGE_CONCURRENCY=2
IMAGE_TIMEOUT_MS=180000
DAILY_IMAGE_CAP=200
# 单次批量最多提交多少个镜头
MAX_BATCH_SIZE=50

# 需要自定义鉴权头 / 额外请求体时填 JSON，例如：
# IMAGE_EXTRA_HEADERS={"x-api-key":"sk-xxx"}
# IMAGE_EXTRA_BODY={"watermark":false}
